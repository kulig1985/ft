# IDE
.idea/
.vscode/

# OS fájlok
.DS_Store
Thumbs.db

# Python
/.venv

# ============================================================
# Stratégia mappákban CSAK a .py fájlok szinkronizálódnak!
# Minden más (config, pair_configs, .env, stb.) VPS-specifikus.
# ============================================================

# Érzékeny adatok
ft_userdata/.env
ft_userdata/user_data/strategies/**/.env

# Minden JSON és YAML a stratégia mappákban (config, pair_configs, hyperopt results)
ft_userdata/user_data/strategies/**/*.json
ft_userdata/user_data/strategies/**/*.json.orignal

# .env.example fájlok (VPS-en saját van)
ft_userdata/user_data/strategies/**/.env.example

# Freqtrade adatbázisok
ft_userdata/user_data/strategies/**/tradesv3.sqlite
ft_userdata/user_data/strategies/**/tradesv3.sqlite-journal
ft_userdata/user_data/strategies/**/tradesv3.sqlite-shm
ft_userdata/user_data/strategies/**/tradesv3.sqlite-wal
ft_userdata/user_data/tradesv3*.sqlite*

# Log fájlok
ft_userdata/user_data/strategies/**/logs/*.log
ft_userdata/user_data/logs/*.log

# Letöltött historikus adatok (nagy méret)
ft_userdata/user_data/data/*
!ft_userdata/user_data/data/.gitkeep

# Hyperopt eredmények
ft_userdata/user_data/hyperopt_results/
ft_userdata/user_data/strategies/**/hyperopt_results/

# FreqAI modellek
ft_userdata/user_data/models/
ft_userdata/user_data/freqaimodels/

# Backtest eredmények
ft_userdata/user_data/backtest_results/
ft_userdata/user_data/strategies/**/backtest_results/

# Plot fájlok
ft_userdata/user_data/plot/

# Jupyter checkpoints
ft_userdata/user_data/notebooks/.ipynb_checkpoints/

# Hyperopt lock
ft_userdata/user_data/hyperopt.lock

# Régi config helyek
ft_userdata/user_data/config*.json

# .gitkeep fájlok megtartása
!**/.gitkeep
