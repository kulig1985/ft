# SuperTrendMacdRsiStrategy - Környezeti változók
# Másold .env néven és töltsd ki!

# Exchange API kulcsok
FREQTRADE__EXCHANGE__KEY=your_exchange_api_key
FREQTRADE__EXCHANGE__SECRET=your_exchange_api_secret

# Telegram bot (SAJÁT bot token ehhez a stratégiához!)
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=your_st_telegram_bot_token
FREQTRADE__TELEGRAM__CHAT_ID=your_chat_id

# API szerver (FreqUI)
FREQTRADE__API_SERVER__USERNAME=your_username
FREQTRADE__API_SERVER__PASSWORD=your_password
# Generálás: python3 -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=your_jwt_secret
# Generálás: python3 -c "import secrets; print(secrets.token_urlsafe(25))"
FREQTRADE__API_SERVER__WS_TOKEN=your_ws_token
