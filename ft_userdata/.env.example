# Freqtrade Environment Variables
# Másold ezt a fájlt .env néven és töltsd ki az értékeket
# NE COMMITOLD A .env FÁJLT GIT-BE!

# Exchange API kulcsok
FREQTRADE__EXCHANGE__KEY=your_exchange_api_key
FREQTRADE__EXCHANGE__SECRET=your_exchange_api_secret

# Telegram bot (opcionális)
FREQTRADE__TELEGRAM__TOKEN=your_telegram_bot_token
FREQTRADE__TELEGRAM__CHAT_ID=your_telegram_chat_id
