# Freqtrade Environment Variables
# Másold ezt a fájlt .env néven és töltsd ki az értékeket
# NE COMMITOLD A .env FÁJLT GIT-BE!

# ============================================
# Exchange API kulcsok (futures tradinghez)
# ============================================
FREQTRADE__EXCHANGE__KEY=your_exchange_api_key
FREQTRADE__EXCHANGE__SECRET=your_exchange_api_secret

# ============================================
# Telegram bot
# ============================================
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=your_telegram_bot_token
FREQTRADE__TELEGRAM__CHAT_ID=your_telegram_chat_id

# ============================================
# API szerver (FreqUI bejelentkezés)
# ============================================
FREQTRADE__API_SERVER__USERNAME=your_username
FREQTRADE__API_SERVER__PASSWORD=your_secure_password
# Generálás: python3 -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=your_jwt_secret_key
# Generálás: python3 -c "import secrets; print(secrets.token_urlsafe(25))"
FREQTRADE__API_SERVER__WS_TOKEN=your_ws_token
